{
  "name": "menq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:design": "python scripts/validate_menq_design_adoption.py",
    "validate": "npm run validate:docs && npm run validate:design && npm run lint && npm run typecheck && npm test -- --run && npm run build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "validate:docs": "python scripts/validate_webpage_documentation.py",
    "verify:brand-tokens": "node scripts/verify_brand_tokens.mjs",
    "e2e:consumer": "node scripts/e2e_consumer_smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next": "16.4.1",
    "nodemailer": "^10.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
